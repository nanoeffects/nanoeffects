{
	"compilerOptions": {
		"jsx": "react-jsx",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2023",
		"lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
		"strict": true,
		"noEmit": true,
		"paths": {
			"nanoeffects": ["../../src/index.ts"],
			"nanoeffects/effects": ["../../src/effects/index.ts"],
			"nanoeffects/policies": ["../../src/policies/index.ts"],
			"nanoeffects/actions": ["../../src/actions/index.ts"],
			"nanoeffects/trace": ["../../src/trace/index.ts"],
			"nanoeffects/redux": ["../../src/store/redux/index.ts"],
			"nanoeffects/observable": ["../../src/observable.ts"],
			"nanoeffects/react": ["../../src/react/index.ts"],
			"nanoeffects/dev": ["../../src/dev/index.ts"],
			"nanoeffects/scope": ["../../src/scope/index.ts"],
			"nanoeffects/match": ["../../src/match/index.ts"],
			"nanoeffects/signal": ["../../src/signal/index.ts"],
			"nanoeffects/context": ["../../src/context/index.ts"],
			"nanoeffects/oop": ["../../src/oop/index.ts"]
		}
	},
	"include": ["src"]
}
