language js

// A step of a policy handler that waits for a call without the signal keeps running after the policy cancels
// the handler. The step is `await call`, `return call`, or an arrow body that is a call.
// It is not flagged when the call mentions the signal (`signal`, `ctx.signal`), gets ctx as an argument, is a call
// on ctx, reads a response body, or gets a variable that the handler set from the signal or from ctx
// (`const options = { signal }`). A handler that wires the signal by hand is skipped.
//
// This is the text-based version of the rule. The ESLint and oxlint rule reads the syntax tree and also checks
// the calls inside `Promise.all([...])` and inside the callbacks of effects.

pattern loses_signal($id, $body) {
	`$callee($callArgs)` as $call where {
		// a mention of `signal` that is not the member of another object (`controller.signal` is not ours)
		$call <: not r"(?s).*(?:^|[^.\w])signal\b.*",
		$call <: not contains `$id.signal`,
		$call <: not contains $id,
		$callee <: not r"(?s)^\w+\.(?:emit|on|off|run|abort)$|.*\.(?:json|text|blob|arrayBuffer|formData|clone)$",
		$callArgs <: not contains `$alias` where {
			$body <: contains `const $alias = $init`,
			$init <: or { r"(?s).*(?:^|[^.\w])signal\b.*", contains `$id.signal`, contains $id }
		},
		register_diagnostic(
			span = $call,
			message = "This step waits for a call that does not get the signal, so it keeps running after the policy cancels the handler. Pass { signal: ctx.signal } to it, or ctx to an effect.",
			severity = "warn"
		)
	}
}

or {
	`latest($fn)`,
	`leading($fn)`,
	`queue($fn)`,
	`debounce($ms, $fn)`,
	`throttle($ms, $fn)`
} where {
	$fn <: or {
		`async ($first, $param) => $body`,
		`($first, $param) => $body`,
		`async function ($first, $param) { $body }`,
		`function ($first, $param) { $body }`
	},
	// the name of ctx when the second parameter is a plain name (with or without a type); a pattern names no ctx
	or { $param <: r"(?s)^(\w+).*"($id), $id = "__no_ctx__" },
	$body <: not contains or { `$signalName.addEventListener($listenerArgs)`, `onAbort($ctxArg, $rest)` },
	// any, not or: every alternative runs, so a handler can have several findings
	any {
		$body <: loses_signal($id, $body),
		$body <: contains `await $call` where { $call <: loses_signal($id, $body) },
		$body <: contains `return $call` where { $call <: loses_signal($id, $body) },
		// bus.emit is not dropped after the handler was cancelled, so a stale call still delivers its result
		$body <: contains `$emitter.emit($emitArgs)` where {
			$emitter <: not $id,
			register_diagnostic(
				span = $emitter,
				message = "This emit is not dropped when the policy cancels the handler, so a stale call still delivers its result. Use ctx.emit.",
				severity = "warn"
			)
		}
	}
}
