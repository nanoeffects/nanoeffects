{
	"name": "nanoeffects",
	"version": "0.2.1",
	"description": "Typed event bus where every handler is a task with an AbortSignal, plus policies (latest, debounce, throttle, queue), effects (retry, timeout, poll) and tracing. About 1.2 kB gzip.",
	"keywords": [
		"event-bus",
		"event-emitter",
		"effects",
		"abort-signal",
		"abortcontroller",
		"debounce",
		"throttle",
		"queue",
		"retry",
		"side-effects",
		"typescript"
	],
	"license": "MIT",
	"author": "Vladimir Yazykov <neizerth@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nanoeffects/nanoeffects.git"
	},
	"bugs": {
		"url": "https://github.com/nanoeffects/nanoeffects/issues"
	},
	"homepage": "https://github.com/nanoeffects/nanoeffects#readme",
	"engines": {
		"node": ">=18"
	},
	"type": "module",
	"packageManager": "pnpm@11.13.0",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"docs"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"notrace": {
				"types": "./dist/notrace/index.d.ts",
				"default": "./dist/notrace/index.js"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./effects": {
			"notrace": {
				"types": "./dist/notrace/effects.d.ts",
				"default": "./dist/notrace/effects.js"
			},
			"types": "./dist/effects.d.ts",
			"import": "./dist/effects.js"
		},
		"./policies": {
			"notrace": {
				"types": "./dist/notrace/policies.d.ts",
				"default": "./dist/notrace/policies.js"
			},
			"types": "./dist/policies.d.ts",
			"import": "./dist/policies.js"
		},
		"./actions": {
			"notrace": {
				"types": "./dist/notrace/actions.d.ts",
				"default": "./dist/notrace/actions.js"
			},
			"types": "./dist/actions.d.ts",
			"import": "./dist/actions.js"
		},
		"./trace": {
			"types": "./dist/trace.d.ts",
			"import": "./dist/trace.js"
		},
		"./redux": {
			"notrace": {
				"types": "./dist/notrace/redux.d.ts",
				"default": "./dist/notrace/redux.js"
			},
			"types": "./dist/redux.d.ts",
			"import": "./dist/redux.js"
		},
		"./observable": {
			"types": "./dist/observable.d.ts",
			"import": "./dist/observable.js"
		},
		"./dev": {
			"production": {
				"types": "./dist/dev.d.ts",
				"default": "./dist/production/dev.js"
			},
			"types": "./dist/dev.d.ts",
			"import": "./dist/dev.js"
		}
	},
	"scripts": {
		"build": "tsdown && node scripts/notrace-types.mjs",
		"prepublishOnly": "pnpm build",
		"check": "biome check ./src ./examples ./integration ./scripts",
		"format": "npx @biomejs/biome check --write --unsafe ./src ./examples ./integration ./scripts",
		"tsgo": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "lefthook install",
		"lint:package": "publint && attw --pack . --profile esm-only",
		"size": "size-limit",
		"verify": "pnpm tsgo && pnpm check && pnpm test && pnpm build && pnpm test:integration && pnpm smoke && pnpm lint:package && pnpm size",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"smoke": "node scripts/smoke.mjs && node scripts/smoke.mjs --notrace",
		"consumer-check": "node scripts/consumer-check.mjs"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@reduxjs/toolkit": "^2.13.0",
		"@size-limit/esbuild": "^14.2.0",
		"@size-limit/file": "^14.2.0",
		"jotai": "^3.0.1",
		"lefthook": "2.2.1",
		"lodash": "4.17.21",
		"mobx": "^7.0.6",
		"publint": "^0.3.25",
		"redux": "^5.0.1",
		"size-limit": "^14.2.0",
		"tsdown": "0.23.1",
		"typescript": "7.0.2",
		"unplugin-unused": "^0.6.0",
		"vite": "^8.3.4",
		"vitest": "5.0.5",
		"webpack": "^5.112.0",
		"zustand": "^5.0.15"
	},
	"publishConfig": {
		"access": "public"
	},
	"size-limit": [
		{
			"name": "createBus",
			"path": "dist/index.js",
			"import": "{ createBus }",
			"limit": "1.2 kB"
		},
		{
			"name": "policies (all)",
			"path": "dist/policies.js",
			"limit": "2.6 kB"
		},
		{
			"name": "effects (all)",
			"path": "dist/effects.js",
			"limit": "2.3 kB"
		},
		{
			"name": "actions (all)",
			"path": "dist/actions.js",
			"limit": "1.8 kB"
		},
		{
			"name": "redux",
			"path": "dist/redux.js",
			"limit": "1.5 kB"
		},
		{
			"name": "observable",
			"path": "dist/observable.js",
			"limit": "0.5 kB"
		},
		{
			"name": "dev",
			"path": "dist/dev.js",
			"limit": "1 kB"
		},
		{
			"name": "dev (production)",
			"path": "dist/production/dev.js",
			"limit": "100 B"
		}
	]
}
