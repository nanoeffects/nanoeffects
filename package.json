{
	"name": "nanoeffects",
	"version": "0.20.0",
	"description": "Cancel stale async work and fix race conditions in event handlers: a typed event bus where every handler is a task with an AbortSignal, plus latest, debounce, throttle, queue, retry, timeout and poll. About 1.4 kB gzip.",
	"keywords": [
		"event-bus",
		"event-emitter",
		"effects",
		"abort-signal",
		"abortcontroller",
		"debounce",
		"throttle",
		"queue",
		"retry",
		"side-effects",
		"race-condition",
		"cancel",
		"cancellation",
		"async",
		"takelatest",
		"switchmap",
		"redux-middleware",
		"saga-alternative",
		"rxjs-alternative",
		"mitt-alternative",
		"typed-events",
		"typescript"
	],
	"license": "MIT",
	"author": "Vladimir Yazykov <neizerth@gmail.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nanoeffects/nanoeffects.git"
	},
	"bugs": {
		"url": "https://github.com/nanoeffects/nanoeffects/issues"
	},
	"homepage": "https://github.com/nanoeffects/nanoeffects#readme",
	"engines": {
		"node": ">=18"
	},
	"type": "module",
	"packageManager": "pnpm@11.28.9",
	"sideEffects": false,
	"files": [
		"dist",
		"llms.txt",
		"llms-full.txt",
		"skills",
		"README.md",
		"LICENSE",
		"docs"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"notrace": {
				"types": "./dist/notrace/index.d.ts",
				"default": "./dist/notrace/index.js"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./effects": {
			"notrace": {
				"types": "./dist/notrace/effects.d.ts",
				"default": "./dist/notrace/effects.js"
			},
			"types": "./dist/effects.d.ts",
			"import": "./dist/effects.js"
		},
		"./policies": {
			"notrace": {
				"types": "./dist/notrace/policies.d.ts",
				"default": "./dist/notrace/policies.js"
			},
			"types": "./dist/policies.d.ts",
			"import": "./dist/policies.js"
		},
		"./actions": {
			"notrace": {
				"types": "./dist/notrace/actions.d.ts",
				"default": "./dist/notrace/actions.js"
			},
			"types": "./dist/actions.d.ts",
			"import": "./dist/actions.js"
		},
		"./scope": {
			"types": "./dist/scope.d.ts",
			"import": "./dist/scope.js"
		},
		"./match": {
			"types": "./dist/match.d.ts",
			"import": "./dist/match.js"
		},
		"./signal": {
			"types": "./dist/signal.d.ts",
			"import": "./dist/signal.js"
		},
		"./context": {
			"types": "./dist/context.d.ts",
			"import": "./dist/context.js"
		},
		"./oop": {
			"types": "./dist/oop.d.ts",
			"import": "./dist/oop.js"
		},
		"./trace": {
			"types": "./dist/trace.d.ts",
			"import": "./dist/trace.js"
		},
		"./redux": {
			"notrace": {
				"types": "./dist/notrace/redux.d.ts",
				"default": "./dist/notrace/redux.js"
			},
			"types": "./dist/redux.d.ts",
			"import": "./dist/redux.js"
		},
		"./observable": {
			"types": "./dist/observable.d.ts",
			"import": "./dist/observable.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"import": "./dist/react.js"
		},
		"./vue": {
			"types": "./dist/vue.d.ts",
			"import": "./dist/vue.js"
		},
		"./dev": {
			"production": {
				"types": "./dist/dev.d.ts",
				"default": "./dist/production/dev.js"
			},
			"types": "./dist/dev.d.ts",
			"import": "./dist/dev.js"
		}
	},
	"scripts": {
		"build": "tsdown && node scripts/notrace-types.mjs && node scripts/llms-full.mjs",
		"prepublishOnly": "pnpm build",
		"check": "biome check ./src ./examples ./integration ./scripts ./packages",
		"format": "npx @biomejs/biome check --write --unsafe ./src ./examples ./integration ./scripts ./packages",
		"tsgo": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "lefthook install",
		"lint:package": "publint && attw --pack . --profile esm-only && publint packages/create-nanoeffects",
		"size": "size-limit",
		"verify": "pnpm tsgo && pnpm check && pnpm docs:check && pnpm llms:check && pnpm templates:check && pnpm test && pnpm build && pnpm test:integration && pnpm smoke && pnpm lint:package && pnpm size",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"templates:check": "node scripts/templates-check.mjs",
		"docs:check": "node scripts/docs-check.mjs",
		"llms:check": "node scripts/llms-full.mjs --check",
		"smoke": "node scripts/smoke.mjs && node scripts/smoke.mjs --notrace",
		"consumer-check": "node scripts/consumer-check.mjs"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@reduxjs/toolkit": "^2.13.0",
		"@size-limit/esbuild": "^14.2.0",
		"@size-limit/file": "^14.2.0",
		"@tanstack/react-query": "^5.105.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"archunit": "^2.5.4",
		"happy-dom": "^21.0.4",
		"immer": "^10.2.0",
		"jotai": "^3.0.1",
		"lefthook": "2.2.1",
		"lodash": "4.17.21",
		"mobx": "^7.0.6",
		"playwright-core": "1.64.1",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"redux": "^5.0.1",
		"size-limit": "^14.2.0",
		"tsdown": "0.23.1",
		"typescript": "7.0.2",
		"typescript-5": "npm:typescript@^5.9.3",
		"unplugin-unused": "^0.6.0",
		"vite": "^8.3.4",
		"vitest": "5.0.5",
		"vue": "^3.5.44",
		"vue-tsc": "^3.3.13",
		"webpack": "^5.112.0",
		"zustand": "^5.0.15"
	},
	"publishConfig": {
		"access": "public"
	},
	"size-limit": [
		{
			"name": "createBus",
			"path": "dist/index.js",
			"import": "{ createBus }",
			"limit": "1.3 kB"
		},
		{
			"name": "policies (all)",
			"path": "dist/policies.js",
			"limit": "2.65 kB"
		},
		{
			"name": "effects (all)",
			"path": "dist/effects.js",
			"limit": "2.45 kB"
		},
		{
			"name": "actions (all)",
			"path": "dist/actions.js",
			"limit": "3.02 kB"
		},
		{
			"name": "match (plugin)",
			"path": "dist/match.js",
			"limit": "0.5 kB"
		},
		{
			"name": "signal (plugin)",
			"path": "dist/signal.js",
			"limit": "0.6 kB"
		},
		{
			"name": "context (plugin)",
			"path": "dist/context.js",
			"limit": "0.2 kB"
		},
		{
			"name": "oop (class entry)",
			"path": "dist/oop.js",
			"limit": "2.6 kB"
		},
		{
			"name": "scope (plugin and effect)",
			"path": "dist/scope.js",
			"limit": "0.75 kB"
		},
		{
			"name": "redux",
			"path": "dist/redux.js",
			"limit": "1.55 kB"
		},
		{
			"name": "observable",
			"path": "dist/observable.js",
			"limit": "0.5 kB"
		},
		{
			"name": "react",
			"path": "dist/react.js",
			"ignore": [
				"react"
			],
			"limit": "1.24 kB"
		},
		{
			"name": "vue",
			"path": "dist/vue.js",
			"ignore": [
				"vue"
			],
			"limit": "0.4 kB"
		},
		{
			"name": "dev",
			"path": "dist/dev.js",
			"limit": "1 kB"
		},
		{
			"name": "dev (production)",
			"path": "dist/production/dev.js",
			"limit": "100 B"
		}
	],
	"peerDependencies": {
		"react": ">=18",
		"vue": ">=3.3"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	}
}
