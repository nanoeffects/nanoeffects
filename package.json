{
	"name": "nanoeffects",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.13.0",
	"sideEffects": false,
	"files": [
		"dist"
	],
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"notrace": {
				"types": "./dist/notrace/index.d.ts",
				"default": "./dist/notrace/index.js"
			},
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./effects": {
			"notrace": {
				"types": "./dist/notrace/effects.d.ts",
				"default": "./dist/notrace/effects.js"
			},
			"types": "./dist/effects.d.ts",
			"import": "./dist/effects.js"
		},
		"./policies": {
			"notrace": {
				"types": "./dist/notrace/policies.d.ts",
				"default": "./dist/notrace/policies.js"
			},
			"types": "./dist/policies.d.ts",
			"import": "./dist/policies.js"
		},
		"./actions": {
			"notrace": {
				"types": "./dist/notrace/actions.d.ts",
				"default": "./dist/notrace/actions.js"
			},
			"types": "./dist/actions.d.ts",
			"import": "./dist/actions.js"
		},
		"./trace": {
			"types": "./dist/trace.d.ts",
			"import": "./dist/trace.js"
		},
		"./redux": {
			"notrace": {
				"types": "./dist/notrace/redux.d.ts",
				"default": "./dist/notrace/redux.js"
			},
			"types": "./dist/redux.d.ts",
			"import": "./dist/redux.js"
		}
	},
	"scripts": {
		"build": "tsdown && node scripts/notrace-types.mjs",
		"prepublishOnly": "pnpm build",
		"check": "biome check ./src",
		"format": "npx @biomejs/biome check --write --unsafe ./src",
		"tsgo": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"lefthook": "2.2.1",
		"lodash": "4.17.21",
		"tsdown": "0.23.1",
		"typescript": "7.0.2",
		"unplugin-unused": "^0.6.0",
		"vitest": "5.0.5"
	}
}
